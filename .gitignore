# raw downloads and caches (regenerate with tools/*.py)
data/
# world/ (tile manifest and tiles streamed by src/world.js) is published, so it is not ignored
tools/.venv/
__pycache__/
*.tmp.js
.claude/
.DS_Store
# performance agent: build output and tool dependencies (dist/ is built by the Pages workflow)
dist/
node_modules/
tools/build/.cache/
*.orig
*.tmp.mjs
*.tmp.js
# secrets and local logs must never reach the public repo (the Mapillary token lives in data/, which is ignored above)
.env
.env.*
*.pem
*.key
*.p12
*.keystore
*credentials*
*.token
*_token
*.secret
secrets.json
*.log
